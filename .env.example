BOT_TOKEN=your_telegram_bot_token
ADMIN_IDS=123456789
# CHANNEL_ID=@your_channel
PORT=7860

# --- Database (pick one) ---
# Option A: SQLite (local development, no external DB required)
DB_ENGINE=sqlite
SQLITE_PATH=rental_bot.db

# Option B: PostgreSQL (production, e.g. Neon.tech)
# DB_ENGINE=postgres
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Legacy: if DB_ENGINE is unset, PostgreSQL is used when DATABASE_URL is set;
# otherwise SQLite is used automatically.
